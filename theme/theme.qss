/* ============================================================
   Honsen WMS Global Theme — Brand Blue + Dark Sidebar
   ============================================================ */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 10pt;
}

QWidget {
    color: #2c3e50;
}

/* --- Application shell --- */

QMainWindow {
    background-color: #F5F6FA;
}

#contentPage {
    background-color: #F5F6FA;
}

#loginWindow {
    background-color: #F5F6FA;
}

#loginBanner {
    background-color: #3f51b5;
    color: #ffffff;
    font-size: 13pt;
    font-weight: bold;
}

#loginCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

#loginTitle {
    font-size: 16pt;
    font-weight: bold;
    color: #1a237e;
}

#loginSubtitle {
    color: #64748b;
    font-size: 9pt;
}

#loginDbHint {
    color: #94a3b8;
    font-size: 8pt;
}

#fieldLabel {
    color: #475569;
    font-weight: bold;
    font-size: 9pt;
}

/* --- Sidebar --- */

#sidebar {
    background-color: #1a237e;
    border-right: 1px solid #283593;
}

#sidebar #logoLabel {
    color: #ff9800;
    font-size: 13pt;
    font-weight: bold;
}

#sidebar QPushButton {
    background-color: transparent;
    color: #c5cae9;
    padding: 12px 16px;
    border: none;
    border-radius: 6px;
    text-align: left;
    font-size: 10pt;
}

#sidebar QPushButton:hover {
    background-color: #283593;
    color: #ffffff;
}

#sidebar QPushButton:checked {
    background-color: #3f51b5;
    color: #ffffff;
    font-weight: bold;
    border-left: 4px solid #ff9800;
    padding-left: 12px;
}

#sidebar QToolButton {
    background-color: #283593;
    color: #ffffff;
    border: none;
    border-radius: 13px;
    min-width: 26px;
    min-height: 26px;
    max-width: 26px;
    max-height: 26px;
}

#sidebar QToolButton:hover {
    background-color: #ff9800;
}

#sidebar #sidebarDivider {
    background-color: #283593;
    max-height: 1px;
}

#sidebar #copyrightLabel {
    color: #7986cb;
    font-size: 8pt;
}

/* --- Page card --- */

#pageCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

#configPanel, #sectionFrame {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

#configPanelTitle, #sectionTitle {
    font-size: 11pt;
    font-weight: bold;
    color: #3f51b5;
}

#pageStatusBar {
    padding: 8px 4px;
    font-weight: bold;
    color: #475569;
    border-top: 1px solid #e2e8f0;
    background-color: #f8fafc;
}

#warningText {
    color: #e65100;
    font-weight: bold;
}

/* --- Inputs --- */

QLineEdit, QDateEdit, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 20px;
    selection-background-color: #3f51b5;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px 8px;
    padding-right: 28px;
    min-height: 28px;
    selection-background-color: #3f51b5;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 2px solid #3f51b5;
    padding: 5px 9px;
}

QComboBox:focus {
    padding: 3px 7px;
    padding-right: 27px;
}

QLineEdit:read-only {
    background-color: #f1f5f9;
    color: #64748b;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    selection-background-color: #3f51b5;
    selection-color: #ffffff;
    outline: none;
    padding: 2px;
    min-height: 192px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 10px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #e8eaf6;
    color: #1a237e;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #3f51b5;
    color: #ffffff;
}

/* --- Buttons by role --- */

QPushButton {
    background-color: #e2e8f0;
    color: #334155;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #cbd5e1;
}

QPushButton:pressed {
    background-color: #94a3b8;
}

QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
}

QPushButton[role="primary"] {
    background-color: #3f51b5;
    color: #ffffff;
}

QPushButton[role="primary"]:hover {
    background-color: #5c6bc0;
}

QPushButton[role="primary"]:pressed {
    background-color: #283593;
}

QPushButton[role="success"] {
    background-color: #43a047;
    color: #ffffff;
}

QPushButton[role="success"]:hover {
    background-color: #66bb6a;
}

QPushButton[role="danger"] {
    background-color: #e53935;
    color: #ffffff;
}

QPushButton[role="danger"]:hover {
    background-color: #ef5350;
}

QPushButton[role="info"] {
    background-color: #1e88e5;
    color: #ffffff;
}

QPushButton[role="info"]:hover {
    background-color: #42a5f5;
}

QPushButton[role="warning"] {
    background-color: #ff9800;
    color: #ffffff;
}

QPushButton[role="warning"]:hover {
    background-color: #ffb74d;
}

QPushButton[role="accent"] {
    background-color: #8e24aa;
    color: #ffffff;
}

QPushButton[role="accent"]:hover {
    background-color: #ab47bc;
}

QPushButton[role="muted"] {
    background-color: #78909c;
    color: #ffffff;
}

QPushButton[role="muted"]:hover {
    background-color: #90a4ae;
}

QPushButton[role="outline"] {
    background-color: transparent;
    color: #475569;
    border: 1px solid #cbd5e1;
}

QPushButton[role="outline"]:hover {
    background-color: #f1f5f9;
    border-color: #3f51b5;
    color: #3f51b5;
}

QPushButton[role="loginPrimary"] {
    background-color: #3f51b5;
    color: #ffffff;
    font-size: 12pt;
    font-weight: bold;
    min-height: 44px;
    border-radius: 8px;
}

QPushButton[role="loginPrimary"]:hover {
    background-color: #5c6bc0;
}

/* --- Tables --- */

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    gridline-color: #e2e8f0;
    selection-background-color: #c5cae9;
    selection-color: #1a237e;
}

QTableWidget::item {
    padding: 4px 6px;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #334155;
    font-weight: bold;
    padding: 8px 6px;
    border: none;
    border-bottom: 2px solid #3f51b5;
    border-right: 1px solid #e2e8f0;
}

QTableWidget QTableCornerButton::section {
    background-color: #f1f5f9;
    border-bottom: 2px solid #3f51b5;
}

/* --- Tabs --- */

QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background-color: #f1f5f9;
    color: #64748b;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #3f51b5;
    border-bottom: 2px solid #3f51b5;
}

QTabBar::tab:hover:!selected {
    background-color: #e2e8f0;
    color: #334155;
}

/* --- Lists --- */

QListWidget {
    background-color: #fafafa;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #c5cae9;
    color: #1a237e;
}

/* --- Scroll areas --- */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: #f1f5f9;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

/* --- Status bar --- */

QStatusBar {
    background-color: #f1f5f9;
    color: #64748b;
    border-top: 1px solid #e2e8f0;
}

/* --- Dialogs --- */

QDialog {
    background-color: #F5F6FA;
}

QMessageBox {
    background-color: #ffffff;
}

QToolTip {
    background-color: #1a237e;
    color: #ffffff;
    border: none;
    padding: 6px 10px;
    border-radius: 4px;
}

#qrLabel {
    background-color: #ffffff;
    border-radius: 8px;
    padding: 8px;
    color: #334155;
}
